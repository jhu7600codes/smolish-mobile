<?xml version="1.0" encoding="utf-8"?>
<!-- launcher shortcut: the smolish character (rounded square with eyes) on the brand blue circle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval"><solid android:color="@color/brand" /><size android:width="48dp" android:height="48dp" /></shape>
    </item>
    <item android:drawable="@drawable/ic_cube" android:gravity="center" android:width="24dp" android:height="24dp" />
</layer-list>
